module

public import Zeta2Lean.Defs

@[expose] public section

/-!
# Zeta2Lean.Z7.Defs — definitions for `ζ₂(7)` alone (configuration cand3)

Target: **`ζ₂(7)` is irrational** (map of statements: `BLUEPRINT_Z7.md`; informal proof:
`docs/proof.md`, quoted below as "proof §x").  This file only adds
the objects of the `ζ₂(7)` construction.  The trusted definitions (`volkenbornSum`, `HasVolkenborn`,
`volkenborn`, `halfPow`, `J`, `zeta2`) and the Volkenborn API are those of `Zeta2Lean/Defs.lean`
(namespace `Zeta2`), shared with the pair project.  Everything here lives in `Zeta2.Z7`.

## The construction (proof §2)

The degree is `n = 40 u` (all statements are indexed by `u : ℕ`; there is no division by `40`).
With `η = (5, 7, 7, 9, 11, 13)/40` (`eta`, in units of `n/40 = u`):
```
C_m = [η_m n, (1 - η_m) n - 1]      (block u m; lengths 3n/4, 13n/20 ×2, 11n/20, 9n/20, 7n/20)
a_k = 1, 2, 3, 4  for  min(k, n-k) < 2u, < 4u, < 6u, else     (apole u k)
R_n(t) = (2t + n) ∏_m ∏_{c ∈ C_m} (t + 1/2 + c) / ∏_{k=0}^{n} (t + k)^{a_k}
```
`N = ∑ |C_m| = 136 u = 3.4 n`, `∑ a_k = N + 4`, so `deg R_n = -3`, and `R_n(-n-t) = -R_n(t)`.
Partial fractions: `R_n(t) = ∑_{k ≤ n} ∑_{i=1}^{a_k} r_{i,k} (t+k)^{-i}` with the explicit Taylor
formula `r_{i,k} = [ε^{a_k - i}] G_k(ε)`, `G_k(ε) = ε^{a_k} R_n(-k+ε)`
```
G_k(ε) = (n - 2k + 2ε) · ∏_m ∏_{c ∈ C_m} (c - k + 1/2 + ε) · (∏_{j ≤ n, j ≠ k} (j - k + ε)^{a_j})⁻¹
```
in `PowerSeries ℚ` (`Gser`; the inverted product has non-zero constant term).  At the centre
`k = n/2` the linear factor is `2ε`, so `r_{4,n/2} = 0` automatically.

## The centred linear form (proof §3)

`S_n := -∫_{ℤ₂} R_n'''(t + 1/2 - n/2) dt` (the **negative** of proof §2's `S_n`, as in the pair,
whose integrand is `-R'''`).  With
`integrand u x = ∑_{i,k} (i)₃ r_{i,k} (x + k - n/2 + 1/2)^{-(i+3)}`
(`genIntegrandZ`, shift `m = n/2 = 20u`) the Volkenborn translation formula for shifts of both
signs (`Stmt_Translation`, `Stmt_TranslationNeg`) gives
```
S_n = rho u + 60 c₃ J₆ = rho u + Zc u · ζ₂(7),     Zc u = 46080 c₃,
rho u = -∑_{i,k} (i)₄ r_{i,k} AhalfZ (k - n/2) (i+4)       (genRhoZ)
```
(`c₁ = 0` by degree, `c₂ = c₄ = 0` by the symmetry, `a_k ≤ 4`).  Relative to proof §3:
`rho u = -ρ_n` and `Zc u = -Z_n` (`Z_n = -46080 c₃` there); valuations and sizes are unchanged.
`AhalfZ d s` is the proof's `sgn(d) ∑_{h ∈ H_k} h^{-s}` (`H_k` = half-integers strictly between `0`
and `d`); `rhoP u = -rho u` is the proof's `ρ_n` written with these sums (used by the denominator
statements).

## Local models of residue classes (proof §4.2–4.7; research engines `python/z7_ref/kernel.py`, `levels.py`)

For an odd prime `q` and `k₀ < q`, the class `ξ = ξ(k₀)` has the local coordinate `v = (t + k₀)/q`.
`localModel u q k₀ : LocalType` lists (with doubled coordinates `w = 2v ∈ ℤ`):
* `items`: poles `(-2j, -a_k)` for `k = k₀ + jq ≤ n`; zeros `(-s, μ(c))` for `s` odd,
  `c = k₀ + (sq - 1)/2 ∈ [0, n)`, `μ(c) > 0`; the `δ`-zero `((2k₀ - n)/q, 1)` if `q ∣ 2k₀ - n`
  (it sits on the centre pole `k = n/2`, whose net order becomes `a - 1 = 3`);
* `pairs`: bad pairs `(-2j, -2j + sgn(d) σ, sgn(d))`, `d = k - n/2 ≠ 0`, `σ` odd, `σ q < 2|d|`.
From a local type: `E = ∑ e` (`LocalType.E`), `r_τ(y) = ∏ (1 - v_w y)^{e_w}` (`rSer`),
`y^E A_τ(1/y)` (`ASer`, principal parts of `RR(v) (v_e - v)^{-5}` at the poles of the pairs),
the class-lemma coefficients `[y^p] D_{τ,κ}` for kernels `κ(y) = c₀ + c y^j` (`coeffD`), the level
predicate `LevGe` ("level `≥ P - 5`"), and the per-pole Taylor data (`taylorAt`, `PoleLevGe`).
The explicit class sums of the proof (`classBad` = `β_ξ`, `goodPart` = `G`, `kerRes` =
`∮_{D_ξ} R_n K`, `farRes` = `∮_{D_ξ} R_n g_{j,ξ}`) are finite sums of the `r_{i,k}`.
All these definitions are transcribed literally in `python/z7_mirror.py`, which checks them
against the research engines (`python/z7_ref/kernel.py`, `levels.py`, `qeng.py`).

## Denominators, growth, constants

`eq7 u q` is the exponent of the prime `q` in the odd common denominator of `rho u` and `Zc u`.
`DenRow` is a row `[a, b) × (f, kernel)` of the certified exponent table `denTable7`
(`Zeta2Lean/Z7/DenTable.lean`, generated by `python/z7_den_table.py`).  `Upot` is the growth
potential `U(κ)` of proof §5.  The target rates are `g7 = 0.71 ≥ U* = 0.70670223` (growth) and
`delta7 = 3.99 ≥ 3.9240892` (the "Lean-friendly" denominator exponent of proof §0.2/§10), with
`g7 + delta7 = 4.70 < 6.8 log 2 = 4.71340`.
-/

set_option linter.style.longLine false

open Filter Topology Finset PowerSeries

noncomputable section

namespace Zeta2.Z7

/-! ## The configuration cand3 -/

/-- The block offsets `40 η_m = (5, 7, 7, 9, 11, 13)`. -/
def eta : Fin 6 → ℕ :=
  ![5, 7, 7, 9, 11, 13]

/-- The block `C_m = [η_m n, (1 - η_m) n - 1]` for `n = 40 u`, as the set of `c` of the numerator
factors `t + 1/2 + c`.  It is invariant under `c ↦ n - 1 - c`. -/
def block (u : ℕ) (m : Fin 6) : Finset ℕ :=
  Ico (eta m * u) (40 * u - eta m * u)

/-- `μ(c)`: the number of blocks containing `c` (the multiplicity of the zero `-1/2 - c`). -/
def mu (u c : ℕ) : ℕ :=
  (univ.filter fun m : Fin 6 => c ∈ block u m).card

/-- The pole order `a_k ∈ {1, 2, 3, 4}` at `-k` (`0 ≤ k ≤ n = 40u`): `1, 2, 3` when
`min(k, n-k) < 2u, 4u, 6u` (i.e. `min(k, n-k)/n < 1/20, 1/10, 3/20`), `4` otherwise.  Symmetric:
`apole u (n - k) = apole u k`. -/
def apole (u k : ℕ) : ℕ :=
  if min k (40 * u - k) < 2 * u then 1
  else if min k (40 * u - k) < 4 * u then 2
  else if min k (40 * u - k) < 6 * u then 3
  else 4

/-- Taylor expansion `ε ↦ ∏_m ∏_{c ∈ C_m} (y + ε + 1/2 + c)` of the numerator at `t = y`. -/
def numSer (u : ℕ) (y : ℚ) : PowerSeries ℚ :=
  ∏ m : Fin 6, ∏ c ∈ block u m, (C (y + 1 / 2 + (c : ℚ)) + X)

/-- `G_k(ε) = ε^{a_k} R_n(-k+ε)
= (n - 2k + 2ε) · numSer u (-k) · (∏_{j ≤ n, j ≠ k} (j - k + ε)^{a_j})⁻¹`. -/
def Gser (u k : ℕ) : PowerSeries ℚ :=
  (C (((40 * u : ℕ) : ℚ) - 2 * k) + C 2 * X) * numSer u (-(k : ℚ)) *
    (∏ j ∈ (range (40 * u + 1)).erase k, (C ((j : ℚ) - k) + X) ^ apole u j)⁻¹

/-- Partial-fraction coefficient `r_{i,k} = [ε^{a_k - i}] G_k(ε)` for `1 ≤ i ≤ a_k`, `k ≤ n`;
`0` otherwise. -/
def rcoef (u i k : ℕ) : ℚ :=
  if 1 ≤ i ∧ i ≤ apole u k ∧ k ≤ 40 * u then coeff (apole u k - i) (Gser u k) else 0

/-! ## Centred generic linear forms (any coefficient array `r`, pole order `≤ a`, shift `m`) -/

/-- `(z + 1/2)^{-s}` for an integer `z`, in `ℚ_[2]` (`halfPowZ s x = halfPow s x` for `x : ℕ`). -/
def halfPowZ (s : ℕ) (z : ℤ) : ℚ_[2] :=
  ((z : ℚ_[2]) + 2⁻¹)⁻¹ ^ s

/-- The centred `A`-sums: `AhalfZ d s = ∑_{0 ≤ l < d} (l + 1/2)^{-s}` for `d ≥ 0` and
`-∑_{l=1}^{-d} (1/2 - l)^{-s}` for `d < 0`.  In both cases it is `sgn(d) ∑_{h} h^{-s}` over the
half-integers `h` strictly between `0` and `d`; the translation formula reads
`∫ (t + 1/2 + d)^{-s} dt = J_s - s · AhalfZ d (s+1)` for every `d ∈ ℤ`. -/
def AhalfZ (d : ℤ) (s : ℕ) : ℚ :=
  if 0 ≤ d then ∑ l ∈ range d.toNat, (((l : ℚ) + 1 / 2)⁻¹) ^ s
  else -∑ l ∈ Icc 1 (-d).toNat, (((1 : ℚ) / 2 - l)⁻¹) ^ s

/-- `∑_{i=1}^{a} ∑_{k=0}^{n} (i)₃ r_{i,k} (x + k - m + 1/2)^{-(i+3)}`: for `r` the partial-fraction
coefficients of `R = ∑ r_{i,k} (t+k)^{-i}` this is `-R'''(x + 1/2 - m)`. -/
def genIntegrandZ (a n m : ℕ) (r : ℕ → ℕ → ℚ) (x : ℕ) : ℚ :=
  ∑ i ∈ Icc 1 a, ∑ k ∈ range (n + 1),
    ((i : ℚ) * (i + 1) * (i + 2)) * r i k * (((((x : ℤ) + k - m : ℤ) : ℚ) + 1 / 2)⁻¹) ^ (i + 3)

/-- `c_i = ∑_{k=0}^{n} r_{i,k}`. -/
def genCsum (n : ℕ) (r : ℕ → ℕ → ℚ) (i : ℕ) : ℚ :=
  ∑ k ∈ range (n + 1), r i k

/-- The rational part `-∑_{i=1}^{a} ∑_{k=0}^{n} (i)₄ r_{i,k} AhalfZ (k - m) (i+4)` of the centred
form. -/
def genRhoZ (a n m : ℕ) (r : ℕ → ℕ → ℚ) : ℚ :=
  -∑ i ∈ Icc 1 a, ∑ k ∈ range (n + 1),
      ((i : ℚ) * (i + 1) * (i + 2) * (i + 3)) * r i k * AhalfZ ((k : ℤ) - m) (i + 4)

/-! ## The linear form of cand3 -/

/-- `c_i = ∑_k r_{i,k}`. -/
def csum (u i : ℕ) : ℚ :=
  genCsum (40 * u) (rcoef u) i

/-- The rational part `ρ` of `S_n` (`= -ρ_n` of proof §3). -/
def rho (u : ℕ) : ℚ :=
  genRhoZ 4 (40 * u) (20 * u) (rcoef u)

/-- `Z = (3)₄ 2^7 c₃ = 46080 c₃`, the coefficient of `ζ₂(7)` (`= -Z_n` of proof §3). -/
def Zc (u : ℕ) : ℚ :=
  46080 * csum u 3

/-- The integrand `-R_n'''(x + 1/2 - n/2)` at `x ∈ ℕ`. -/
def integrand (u x : ℕ) : ℚ :=
  genIntegrandZ 4 (40 * u) (20 * u) (rcoef u) x

/-- `S_n = -∫_{ℤ₂} R_n'''(t + 1/2 - n/2) dt` (only a name; statements use `HasVolkenborn`). -/
def Sn (u : ℕ) : ℚ_[2] :=
  volkenborn (fun x => ((integrand u x : ℚ) : ℚ_[2]))

/-- The linear form `ρ + Z ζ₂(7)` (the value of `S_n`, by `Stmt_L7`). -/
def Lform (u : ℕ) : ℚ_[2] :=
  (rho u : ℚ_[2]) + (Zc u : ℚ_[2]) * zeta2 7

/-! ## Product form of `R_n` -/

/-- The numerator `(2t + n) ∏_m ∏_{c ∈ C_m} (t + 1/2 + c)` as a polynomial. -/
def Rnum (u : ℕ) : Polynomial ℚ :=
  (Polynomial.C 2 * Polynomial.X + Polynomial.C ((40 * u : ℕ) : ℚ)) *
    ∏ m : Fin 6, ∏ c ∈ block u m, (Polynomial.X + Polynomial.C (1 / 2 + (c : ℚ)))

/-- `∏_k (t+k)^{a_k} · ∑_{i,k} r_{i,k} (t+k)^{-i}` as a polynomial. -/
def PFpoly (u : ℕ) : Polynomial ℚ :=
  ∑ k ∈ range (40 * u + 1), ∑ i ∈ Icc 1 (apole u k),
    Polynomial.C (rcoef u i k) * (Polynomial.X + Polynomial.C (k : ℚ)) ^ (apole u k - i) *
      ∏ j ∈ (range (40 * u + 1)).erase k, (Polynomial.X + Polynomial.C (j : ℚ)) ^ apole u j

/-- The Taylor expansion `ε ↦ R_n(y + ε)` (meaningful when `y ∉ {0, -1, …, -n}`). -/
def Rser (u : ℕ) (y : ℚ) : PowerSeries ℚ :=
  (C (2 * y + ((40 * u : ℕ) : ℚ)) + C 2 * X) * numSer u y *
    (∏ j ∈ range (40 * u + 1), (C (y + j) + X) ^ apole u j)⁻¹

/-! ## Valuations and the odd denominator -/

/-- `v_q(x) ≥ L` (true for `x = 0`), through Mathlib's `padicNorm`. -/
def ValGe (q : ℕ) (L : ℤ) (x : ℚ) : Prop :=
  padicNorm q x ≤ (q : ℚ) ^ (-L)

/-- `e_q(n) = max(0, -v_q(ρ), -v_q(Z))`: the exponent of `q` in the least common denominator of
`rho u` and `Zc u`. -/
def eq7 (u q : ℕ) : ℕ :=
  max (padicValNat q (rho u).den) (padicValNat q (Zc u).den)

/-! ## Local types (proof §4.2–4.5) -/

/-- A local model of a residue class, in doubled local coordinates `w = 2v`:
`items` are the factors `(v - w/2)^e` of `RR_ξ(v)` (poles `e < 0`, zeros and the `δ`-zero `e > 0`;
the `δ`-zero is a separate item at the position of the centre pole), `pairs` are the bad pairs
`(w_k, w_e, sgn)` (pole at `w_k/2`, evaluation point at `w_e/2`, sign `sgn(d_k)`). -/
structure LocalType where
  /-- `(w, e)`: the factor `(v - w/2)^e`. -/
  items : List (ℤ × ℤ)
  /-- `(w_k, w_e, sg)`: a bad pair. -/
  pairs : List (ℤ × ℤ × ℤ)

namespace LocalType

/-- `E_ξ = ∑ e_w`. -/
def E (τ : LocalType) : ℤ :=
  (τ.items.map Prod.snd).sum

/-- The net exponent at the local point `w/2` (e.g. `-3` at the centre pole: `-4 + 1`). -/
def netE (τ : LocalType) (w : ℤ) : ℤ :=
  ((τ.items.filter fun p => p.1 = w).map Prod.snd).sum

end LocalType

/-- The generalised binomial coefficient `C(e, i) = e (e-1) ⋯ (e-i+1) / i!`, `e ∈ ℤ`. -/
def gchoose (e : ℤ) (i : ℕ) : ℚ :=
  (∏ t ∈ range i, ((e : ℚ) - t)) / (i.factorial : ℚ)

/-- The binomial series `(1 + c X)^e`, `e ∈ ℤ`. -/
def bser (c : ℚ) (e : ℤ) : PowerSeries ℚ :=
  PowerSeries.mk fun i => gchoose e i * c ^ i

/-- `r_τ(y) = ∏_{(w,e)} (1 - (w/2) y)^e = y^E RR(1/y)`. -/
def rSer (τ : LocalType) : PowerSeries ℚ :=
  (τ.items.map fun p => bser (-(p.1 : ℚ) / 2) p.2).prod

/-- The Taylor series `τ_k(u) = ∏_{(w,e), w ≠ w_k} ((w_k - w)/2 + u)^e` of `u^a RR(v_k + u)` at a
local point `v_k = w_k/2` (the items at `w_k` itself are left out). -/
def taylorAt (τ : LocalType) (wk : ℤ) : PowerSeries ℚ :=
  ((τ.items.filter fun p => p.1 ≠ wk).map fun p =>
    C (((wk - p.1 : ℚ) / 2) ^ p.2) * bser (2 / (wk - p.1 : ℚ)) p.2).prod

/-- `g(u) = τ_k(u) · (b - u)^{-5}`, `b = (w_e - w_k)/2`: the Taylor series whose coefficients
`g_{a-i}` are the principal-part coefficients of `RR(v) (v_e - v)^{-5}` at `v_k`. -/
def gSer (τ : LocalType) (wk we : ℤ) : PowerSeries ℚ :=
  taylorAt τ wk * (C (((we - wk : ℚ) / 2) ^ (-5 : ℤ)) * bser (-2 / (we - wk : ℚ)) (-5))

/-- `A_τ(1/y) = ∑_{pairs} sgn ∑_{i=1}^{a} g_{a-i} y^i (1 - v_k y)^{-i}` (`a` the net pole order at
`v_k`); `[y^p] (y^E A_τ(1/y)) = [y^{p-E}] ASer τ`. -/
def ASer (τ : LocalType) : PowerSeries ℚ :=
  (τ.pairs.map fun pr =>
    C (pr.2.2 : ℚ) * ∑ i ∈ Icc 1 (-(τ.netE pr.1)).toNat,
      C (coeff ((-(τ.netE pr.1)).toNat - i) (gSer τ pr.1 pr.2.1)) * X ^ i *
        bser (-(pr.1 : ℚ) / 2) (-(i : ℤ))).sum

/-- The coefficient of `y^z` (`0` for `z < 0`). -/
def coeffZ (f : PowerSeries ℚ) (z : ℤ) : ℚ :=
  if 0 ≤ z then coeff z.toNat f else 0

/-- `[y^p] D_{τ,κ}(y)`, `D_{τ,κ} = y^E A_τ(1/y) - r_τ(y) κ(y)`, for the kernel
`κ(y) = c₀ + c y^j`. -/
def coeffD (τ : LocalType) (c0 : ℚ) (j : ℕ) (c : ℚ) (p : ℤ) : ℚ :=
  coeffZ (ASer τ) (p - τ.E) - c0 * coeffZ (rSer τ) p - c * coeffZ (rSer τ) (p - j)

/-- `Lev_κ(τ) ≥ P - 5`: the coefficients `[y^p] D_{τ,κ}` vanish for `E + 1 ≤ p < P`. -/
def LevGe (τ : LocalType) (c0 : ℚ) (j : ℕ) (c : ℚ) (P : ℤ) : Prop :=
  ∀ p : ℤ, τ.E + 1 ≤ p → p < P → coeffD τ c0 j c p = 0

/-- The per-pole level at `w_k` is `≥ T` (proof Lemma 4.7): with `a = -netE w_k` the Taylor
coefficients `τ_l` vanish for `E + a - T < l ≤ a - 1` (vacuous at zeros, where `a ≤ 0`). -/
def PoleLevAt (τ : LocalType) (wk : ℤ) (T : ℤ) : Prop :=
  ∀ l : ℕ, (l : ℤ) + 1 ≤ -τ.netE wk → τ.E - τ.netE wk - T < l → coeff l (taylorAt τ wk) = 0

/-- Every pole of `τ` has per-pole level `≥ T`. -/
def PoleLevGe (τ : LocalType) (T : ℤ) : Prop :=
  ∀ p ∈ τ.items, PoleLevAt τ p.1 T

/-- The discrete local model of the residue class `k₀` modulo `q` (proof §4.2; `kernel.local_items`
of the research code).  Doubled coordinates `w = 2v`, `v = (t + k₀)/q`. -/
def localModel (u q k₀ : ℕ) : LocalType where
  items :=
    ((List.range (40 * u / q + 1)).filterMap fun j =>
        if k₀ + j * q ≤ 40 * u then some (-(2 * (j : ℤ)), -((apole u (k₀ + j * q) : ℕ) : ℤ))
        else none) ++
    ((List.range (40 * u / q + 2)).filterMap fun t =>
        if 0 ≤ (k₀ : ℤ) + t * q - (q + 1) / 2 ∧ (k₀ : ℤ) + t * q - (q + 1) / 2 < 40 * u ∧
            mu u ((k₀ : ℤ) + t * q - (q + 1) / 2).toNat ≠ 0 then
          some (-(2 * (t : ℤ) - 1), (mu u ((k₀ : ℤ) + t * q - (q + 1) / 2).toNat : ℤ))
        else none) ++
    (if (2 * (k₀ : ℤ) - 40 * u) % q = 0 then [((2 * (k₀ : ℤ) - 40 * u) / q, 1)] else [])
  pairs :=
    (List.range (40 * u / q + 1)).flatMap fun j =>
      if k₀ + j * q ≤ 40 * u ∧ (k₀ : ℤ) + j * q - 20 * u ≠ 0 then
        (List.range (((k₀ : ℤ) + j * q - 20 * u).natAbs / q + 1)).filterMap fun t =>
          if ((2 * t + 1) * q : ℤ) < 2 * |(k₀ : ℤ) + j * q - 20 * u| then
            some (-(2 * (j : ℤ)),
              -(2 * (j : ℤ)) + ((k₀ : ℤ) + j * q - 20 * u).sign * (2 * t + 1),
              ((k₀ : ℤ) + j * q - 20 * u).sign)
          else none
      else []

/-! ## The class sums of proof §4 (finite sums of the `r_{i,k}`) -/

/-- `X(k, o/2) = ∑_{i=1}^{4} (i)₄ r_{i,k} (2/o)^{i+4}`, for an odd integer `o = 2h`. -/
def Xk (u k : ℕ) (o : ℤ) : ℚ :=
  ∑ i ∈ Icc (1 : ℕ) 4,
    ((i : ℚ) * (i + 1) * (i + 2) * (i + 3)) * rcoef u i k * ((2 : ℚ) / o) ^ (i + 4)

/-- The odd integers `o = 2h`, `h` a half-integer strictly between `0` and `d`. -/
def oddBetween (d : ℤ) : Finset ℤ :=
  if 0 ≤ d then (range d.toNat).image fun l : ℕ => 2 * (l : ℤ) + 1
  else (range (-d).toNat).image fun l : ℕ => -(2 * (l : ℤ) + 1)

/-- The proof's `ρ_n = ∑_k sgn(d_k) ∑_{h ∈ H_k} X(k,h)` (`d_k = k - n/2`); it equals `-rho u`. -/
def rhoP (u : ℕ) : ℚ :=
  ∑ k ∈ range (40 * u + 1), ((((k : ℤ) - 20 * u).sign : ℤ) : ℚ) *
    ∑ o ∈ oddBetween ((k : ℤ) - 20 * u), Xk u k o

/-- `β_ξ`: the bad part (`q ∣ 2h`) of `ρ_n` over the poles of the class `k ≡ k₀ (mod q)`. -/
def classBad (u q k₀ : ℕ) : ℚ :=
  ∑ k ∈ (range (40 * u + 1)).filter (fun k => k % q = k₀),
    ((((k : ℤ) - 20 * u).sign : ℤ) : ℚ) *
      ∑ o ∈ (oddBetween ((k : ℤ) - 20 * u)).filter (fun o => (q : ℤ) ∣ o), Xk u k o

/-- `G`: the good part (`q ∤ 2h`) of `ρ_n`. -/
def goodPart (u q : ℕ) : ℚ :=
  ∑ k ∈ range (40 * u + 1), ((((k : ℤ) - 20 * u).sign : ℤ) : ℚ) *
    ∑ o ∈ (oddBetween ((k : ℤ) - 20 * u)).filter (fun o => ¬ (q : ℤ) ∣ o), Xk u k o

/-- `C(-j, i) = (-1)^i C(i+j-1, i)` (for `j ≥ 1`). -/
def negChoose (j i : ℕ) : ℚ :=
  (-1) ^ i * ((i + j - 1).choose i : ℚ)

/-- `∮_{D_ξ} R_n(t) K_ξ(t) dt` for the kernel `K_ξ = c₀ + c q^j (t + k₀)^{-j}` (i.e.
`K(v) = c₀ + c v^{-j}`): the residues of `R_n` at the poles `-k` of the class (`c₀ r_{1,k}` and the
`(t+k₀)^{-j}` part), plus the residue at the kernel pole `-k₀`, where the regular part of `R_n`
is expanded through its partial fractions. -/
def kerRes (u q k₀ : ℕ) (c0 : ℚ) (j : ℕ) (c : ℚ) : ℚ :=
  c0 * ∑ k ∈ (range (40 * u + 1)).filter (fun k => k % q = k₀), rcoef u 1 k +
    c * (q : ℚ) ^ j *
      (∑ k ∈ (range (40 * u + 1)).filter (fun k => k % q = k₀ ∧ k ≠ k₀), ∑ i ∈ Icc (1 : ℕ) 4,
          rcoef u i k * negChoose j (i - 1) * (((k₀ : ℚ) - k)⁻¹) ^ (i + j - 1) +
        ∑ k ∈ (range (40 * u + 1)).erase k₀, ∑ i ∈ Icc (1 : ℕ) 4,
          rcoef u i k * negChoose i (j - 1) * (((k : ℚ) - k₀)⁻¹) ^ (i + j - 1))

/-- `∮_{D_ξ} R_n(t) g_{j,ξ}(t) dt`, `g_{j,ξ}(t) = ∑_{i' < q, i' ≠ k₀} (t + i')^{-j}` (analytic on
the disc): the residues at the poles of the class. -/
def farRes (u q k₀ j : ℕ) : ℚ :=
  ∑ k ∈ (range (40 * u + 1)).filter (fun k => k % q = k₀), ∑ i ∈ Icc (1 : ℕ) 4,
    rcoef u i k * ∑ i' ∈ (range q).erase k₀,
      negChoose j (i - 1) * (((i' : ℚ) - k)⁻¹) ^ (i + j - 1)

/-! ## The exponent table (data in `Zeta2Lean/Z7/DenTable.lean`) -/

/-- A row of the certified exponent table: on `x = n/q ∈ [a, b)` (`a = an/ad`, `b = bn/bd`) the
exponent is `≤ f`, certified with the kernel `κ(y) = c0 + c y^j` (`c = 0`: constant kernel). -/
structure DenRow where
  /-- numerator of the left end `a` -/
  an : ℕ
  /-- denominator of the left end `a` -/
  ad : ℕ
  /-- numerator of the right end `b` -/
  bn : ℕ
  /-- denominator of the right end `b` -/
  bd : ℕ
  /-- the exponent bound -/
  f : ℕ
  /-- kernel constant term -/
  c0 : ℚ
  /-- kernel pole order (`≥ 1`; irrelevant when `c = 0`) -/
  j : ℕ
  /-- kernel coefficient of `y^j` -/
  c : ℚ

namespace DenRow

/-- The left end `a` of the row. -/
def a (r : DenRow) : ℚ :=
  (r.an : ℚ) / r.ad

/-- The right end `b` of the row. -/
def b (r : DenRow) : ℚ :=
  (r.bn : ℚ) / r.bd

/-- The row translated by `40 t` (periodicity of the residue level, proof Lemma 4.12). -/
def shift (t : ℕ) (r : DenRow) : DenRow :=
  { r with an := r.an + 40 * t * r.ad, bn := r.bn + 40 * t * r.bd }

/-- The bound `41!^256` for the denominators of the kernel constants (all their prime factors are
`≤ 17`, so they are `q`-integral for every prime `q > 41`). -/
def denBound : ℕ :=
  (Nat.factorial 41) ^ 256

/-- Sanity conditions used by `Stmt_ExpBounds7` (checked by the kernel on the table). -/
def sane (r : DenRow) : Bool :=
  decide (0 < r.ad) && decide (0 < r.bd) && decide (1 ≤ r.j) && decide (r.j ≤ 4) &&
    decide (r.f ≤ 14) && (decide (r.c = 0) || decide (4 ≤ r.f + r.j)) &&
    decide (r.c0.den ∣ denBound) && decide (r.c.den ∣ denBound)

end DenRow

/-! ## Growth (proof §5) -/

/-- `F(z) = z log|z| - z` (`F(0) = 0`), an antiderivative of `log|z|`. -/
def Fx (z : ℝ) : ℝ :=
  z * Real.log |z| - z

/-- The 18 terms `(w_j, 40 p_j)` of `U(κ) = ∑_j w_j F(p_j - κ)`: `+1` at `1 - η_m`, `-1` at `η_m`
(blocks), `+1` at `0, 1/20, 1/10, 3/20` and `-1` at `17/20, 9/10, 19/20, 1` (pole levels). -/
def upotTerms : List (ℤ × ℕ) :=
  [(1, 0), (1, 2), (1, 4), (-1, 5), (1, 6), (-2, 7), (-1, 9), (-1, 11), (-1, 13), (1, 27),
    (1, 29), (1, 31), (2, 33), (-1, 34), (1, 35), (-1, 36), (-1, 38), (-1, 40)]

/-- The growth potential `U(κ) = ∑_m ∫_{η_m}^{1-η_m} log|z-κ| dz - ∫_0^1 a(z) log|z-κ| dz`
(proof §5); `max_{[0,1]} U = 0.7067022242…` at `κ* = 0.10673…` and `1 - κ*`. -/
def Upot (κ : ℝ) : ℝ :=
  (upotTerms.map fun t => (t.1 : ℝ) * Fx ((t.2 : ℝ) / 40 - κ)).sum

/-! ## Target rates -/

/-- Target growth rate (`≥ U* = 0.70670223`). -/
def g7 : ℝ :=
  71 / 100

/-- Target denominator rate (`≥ 3.9240892`, the Lean-friendly truncation of proof §0.2). -/
def delta7 : ℝ :=
  399 / 100

/-! ## Basic API -/

theorem apole_pos (u k : ℕ) : 1 ≤ apole u k := by
  unfold apole
  split_ifs <;> omega

theorem apole_le (u k : ℕ) : apole u k ≤ 4 := by
  unfold apole
  split_ifs <;> omega

end Zeta2.Z7

