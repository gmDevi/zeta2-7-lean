/-- The exponent table on `[1, 140)`. -/
def denTable7 : List DenRow :=
  headRows7 ++ resRows7 ++ resRows7.map (DenRow.shift 1) ++ resRows7.map (DenRow.shift 2)

/-- Every row is sane (`1 ≤ j ≤ 4`, `f ≤ 14`, far-part condition, `41`-smooth kernel
denominators); checked by the kernel. -/
theorem denTable7_sane : denTable7.all DenRow.sane = true := by decide +kernel

/-- Fixed-point scale for the exponent integral (exact `ℚ` arithmetic does not reduce in the
kernel). -/
def Sfix7 : ℕ := 10 ^ 15

/-- `f (⌈S/a⌉ - ⌊S/b⌋) ≥ S f (1/a - 1/b)` for a row `[a, b)`. -/
def Uterm7 (r : DenRow) : ℕ :=
  r.f * ((Sfix7 * r.ad + r.an - 1) / r.an - (Sfix7 * r.bd) / r.bn)

/-- The exponent integral `∑ f (1/a - 1/b)` over `[1, 140)` plus the tail `10/140` is
`≤ 3.99 = delta7`, in fixed point (true value `3.9240891610`); checked by the kernel. -/
theorem denTable7_integral_fixed :
    (denTable7.map Uterm7).sum + (10 * Sfix7 + 139) / 140 ≤ 399 * Sfix7 / 100 := by
  decide +kernel

end Zeta2.Z7
