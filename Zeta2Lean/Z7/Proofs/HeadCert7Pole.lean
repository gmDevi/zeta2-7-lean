module

public import Zeta2Lean.Z7.Proofs.HeadCert7Series

@[expose] public section

/-!
# `HeadCert7`: exceptional `PoleLevGe` jobs (generated by `HeadCert7_gen.py`)

`⟨τ, T⟩ : HC7.PoleJob` with `T = -f` for the exceptional states with `E < -1 - f`; the kernel
check `poleJobs_ok` evaluates `HC7.poleChk`.
-/

set_option linter.style.longLine false

namespace Zeta2.Z7

namespace HC7

/-- Exceptional `PoleLevGe` jobs. -/
def poleJobs : List PoleJob := [
  ⟨mkT [0, -4, -1, 1] [], 0⟩,
  ⟨mkT [0, -4] [], 0⟩,
  ⟨mkT [0, -4, 0, 1] [], 0⟩,
  ⟨mkT [0, -4, 1, 1] [], 0⟩,
  ⟨mkT [0, -4, -1, 1] [], -1⟩,
  ⟨mkT [0, -4] [], -1⟩,
  ⟨mkT [0, -4, 0, 1] [], -1⟩,
  ⟨mkT [0, -4, 1, 1] [], -1⟩,
  ⟨mkT [0, -4] [], -2⟩]

theorem poleJobs_ok : poleJobs.all PoleJob.ok = true := by
  decide +kernel

end HC7

end Zeta2.Z7
