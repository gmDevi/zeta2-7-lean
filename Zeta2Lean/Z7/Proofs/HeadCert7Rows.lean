module

public import Zeta2Lean.Z7.Proofs.HeadCert7Data0
public import Zeta2Lean.Z7.Proofs.HeadCert7Data1
public import Zeta2Lean.Z7.Proofs.HeadCert7Data2
public import Zeta2Lean.Z7.Proofs.HeadCert7Data3
public import Zeta2Lean.Z7.Proofs.HeadCert7Data4
public import Zeta2Lean.Z7.Proofs.HeadCert7Data5
public import Zeta2Lean.Z7.Proofs.HeadCert7Data6
public import Zeta2Lean.Z7.Proofs.HeadCert7Data7

@[expose] public section

/-!
# `HeadCert7`: all row certificates (generated by `HeadCert7_gen.py`)

`HC7.hrows7` = the certificates of the 469 rows of `headRows7`, in order (`hrows7_aligned`), all
valid (`hrows7_ok`).
-/

set_option linter.style.longLine false

namespace Zeta2.Z7

namespace HC7

/-- All row certificates. -/
def hrows7 : List HRow :=
  hrows7_0 ++ hrows7_1 ++ hrows7_2 ++ hrows7_3 ++ hrows7_4 ++ hrows7_5 ++ hrows7_6 ++ hrows7_7

theorem hrows7_ok : hrows7.all rowOK = true := by
  simp only [hrows7, List.all_append, hrows7_0_ok, hrows7_1_ok, hrows7_2_ok, hrows7_3_ok, hrows7_4_ok, hrows7_5_ok, hrows7_6_ok, hrows7_7_ok, Bool.and_self]

theorem hrows7_aligned : aligned headRows7 hrows7 = true := by
  decide +kernel

end HC7

end Zeta2.Z7
